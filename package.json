{
  "name": "nyumbani",
  "private": true,
  "version": "0.1.0",
  "description": "Nyumbani — USSD storefront, order desk & smart inventory for African makers",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@nyumbani/*\" dev",
    "dev:api": "pnpm --filter @nyumbani/api dev",
    "dev:web": "pnpm --filter @nyumbani/web dev",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @nyumbani/api migrate",
    "db:migrate:dev": "pnpm --filter @nyumbani/api migrate:dev",
    "db:seed": "pnpm --filter @nyumbani/api seed",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "start": "pnpm --filter @nyumbani/api start"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "dependencies": {
    "africastalking": "^0.7.9"
  }
}
