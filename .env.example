# ── Core ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://nyumbani:nyumbani@localhost:5433/nyumbani
JWT_SECRET=change-me-in-production

# ── Business (per-deployment config → Marketplace) ─────
BUSINESS_NAME="Kamau Woodworks"
BUSINESS_TAGLINE="Handcrafted furniture, made to order"
OWNER_PHONE=+2547XXXXXXXX
USSD_SERVICE_CODE=*384*1234#

# Public base URL — set to your ngrok URL (e.g. https://abc123.ngrok-free.app)
# so Africa's Talking can reach the callbacks below:
#   {PUBLIC_BASE_URL}/ussd/callback
#   {PUBLIC_BASE_URL}/webhooks/payments
PUBLIC_BASE_URL=

# ── Africa's Talking ────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_ENVIRONMENT=sandbox

# ── M-Pesa via Safaricom Daraja ─────────────────────────
# Create an app at https://developer.safaricom.co.ke (Lipa na M-Pesa Online scope).
# Sandbox shortcode 174379 + public sandbox passkey are pre-set; just add your
# consumer key/secret. For production set your own shortcode + passkey.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379

# ── AI ──────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Web ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
